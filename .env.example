# Copy this to .env and fill in real values:  cp .env.example .env
# .env is ignored by git; this example file is committed so others know what's needed.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://transit:change-me@localhost:5433/transit

# Separate database for automated tests (they delete data!). Must end in _test.
TEST_DATABASE_URL=postgresql://transit:change-me@localhost:5433/transit_test

# Login for the Grafana dashboard at http://localhost:3000 (user: admin)
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Production only (docker-compose.prod.yml) ----
# Your site's domain name. Its DNS "A record" must point at the server's IP address.
DOMAIN=transit.example.com
# Password for the read-only database user the public API uses.
API_DB_PASSWORD=change-me
